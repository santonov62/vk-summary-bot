# Ключ доступа СООБЩЕСТВА с правами «Сообщения сообщества» (как получить — см. README.md)
# Никому не передавайте: он даёт доступ к сообщениям сообщества
VK_GROUP_TOKEN=vk1.a.xxxxxxxx

# Провайдер ИИ: spiderssense (Claude и др.) или nvidia (Nemotron)
LLM_PROVIDER=spiderssense

# SpidersSense (https://spiderssense.com)
SPIDERSSENSE_API_KEY=sk-uno-xxxxxxxx
SPIDERSSENSE_MODEL=anthropic/claude-opus-5.5

# Ключ NVIDIA (https://build.nvidia.com)
NVIDIA_API_KEY=nvapi-xxxxxxxx
# Модель с поддержкой картинок (нужна, чтобы /ии понимал фото)
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Часовой пояс для «сегодня/вчера»
TIMEZONE=Europe/Moscow
# Максимум сообщений, которые загружаются для одной сводки
MAX_MESSAGES=3000
# Пауза между командами в одном чате, сек (0 — без ограничения; на ADMIN_IDS не действует)
COMMAND_COOLDOWN_SEC=60
# Пауза между вопросами /ии в одном чате, сек (0 — без ограничения)
ASK_COOLDOWN_SEC=15
# ID пользователей VK через запятую, на которых не действует пауза между командами (например, ваш)
ADMIN_IDS=

# Сервер для npm run deploy / npm run logs (вход по SSH-ключу)
DEPLOY_HOST=root@1.2.3.4
